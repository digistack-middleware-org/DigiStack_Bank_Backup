<?xml version="1.0" encoding="UTF-8"?>
<web-bnd
    xmlns="http://websphere.ibm.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee
                        http://websphere.ibm.com/xml/ns/javaee/ibm-web-bnd_1_0.xsd"
    version="1.0">

    <!--
        Binding: maps the resource-ref name from web.xml (java:comp/env/jdbc/*)
        to the actual JNDI name registered in the WAS namespace.

        jdbc/BankDS was bound at v7.
        jdbc/DebitDS and jdbc/CreditDS are new at v8.5.
    -->
    <resource-ref name="jdbc/BankDS"   binding-name="jdbc/BankDS"/>
    <resource-ref name="jdbc/DebitDS"  binding-name="jdbc/DebitDS"/>
    <resource-ref name="jdbc/CreditDS" binding-name="jdbc/CreditDS"/>

</web-bnd>